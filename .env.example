# Provider key — never commit the real .env
# Alibaba Cloud Model Studio, OpenAI-compatible endpoint.
# Keys are region-scoped: a Beijing key returns 401 against the Singapore
# endpoint and vice versa. See ADR-007 for the residency discussion.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Models under test (ADR-007). Dated snapshots, never floating aliases.
TRIAGE_MODEL_A=qwen3.7-flash-2026-07-15
TRIAGE_MODEL_B=qwen3.7-plus-2026-05-26

# Cross-family, and different from each other (ADR-007)
GENERATOR_MODEL=kimi-k3
JUDGE_MODEL=deepseek-v4-pro

# DeepEval telemetry off — this repo handles simulated customer data
DEEPEVAL_TELEMETRY_OPT_OUT=YES
