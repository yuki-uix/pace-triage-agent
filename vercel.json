{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": "{data/assignment_demo_v1.jsonl,knowledge/**,results/assignment_demo_v1.json}"
    }
  },
  "rewrites": [
    { "source": "/api/demo", "destination": "/api/index?route=demo" },
    { "source": "/api/run", "destination": "/api/index?route=run" },
    { "source": "/styles.css", "destination": "/web_demo/styles.css" },
    { "source": "/app.js", "destination": "/web_demo/app.js" },
    { "source": "/(.*)", "destination": "/web_demo/index.html" }
  ]
}
